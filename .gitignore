# Secrets: API keys live only in .env
.env

# Data lives in D:\chrono-data. Never commit raw news or prices (size and license).
data/
*.parquet
*.csv.gz

# Python
.venv/
__pycache__/
*.pyc

# Hypothesis keeps its example database here
.hypothesis/

# Run outputs hold returns: they go to D:\chrono-data\runs. Only the trial ledger and its settings files are kept.
runs/*
!runs/trials.csv
!runs/settings/
