# Copy this file to .env and fill in your own keys. .env is gitignored. Never commit it or paste it anywhere.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Market data (news and bars). Paper-account keys should work here too; research/alpaca_check.py confirms it.
APCA_DATA_URL=https://data.alpaca.markets

# Paper trading, for later (orders only, never needed for the backtest)
APCA_TRADING_URL=https://paper-api.alpaca.markets/v2

# Where downloaded data lives, outside the repo
CHRONO_DATA_DIR=D:\chrono-data
